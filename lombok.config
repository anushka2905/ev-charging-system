# Lombok Configuration for EV Charging System
# This file configures Lombok behavior for both Maven and Eclipse

# Prevent Lombok from adding @SuppressWarnings("all") to generated code
lombok.addSuppressWarnings = false

# Lombok version compatibility
config.stopBubbling = true

# Ensures @Builder.Default fields are properly handled
lombok.builder.flagUsage = ALLOW

# Ensure @FieldDefaults doesn't inadvertently change access
lombok.fieldDefaults.defaultPrivate = false
